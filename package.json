  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:native && npm run bundle:android:smoke",
    "test": "vitest run",
    "release": "bash scripts/release.sh",
    "test:native": "jest --config jest.config.cjs --runInBand",
    "bundle:android:smoke": "rm -rf .local/metro-smoke && expo export --platform android --output-dir .local/metro-smoke --clear",
    "verify:android:recovery": "bash scripts/verify-android-recovery.sh"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "private": true
